{%- paginate collection.products by 12 -%}

<div class="collection-page" style="padding:3rem 0 5rem;">
  <div class="container">

    <!-- Collection Header -->
    <div class="text-center" style="margin-bottom:3rem;">
      {%- if collection.image -%}
        <div style="position:relative;border-radius:var(--border-radius-lg);overflow:hidden;aspect-ratio:4/1;margin-bottom:2rem;">
          <img
            src="{{ collection.image | image_url: width: 1400 }}"
            alt="{{ collection.title }}"
            width="1400"
            height="350"
            loading="eager"
            style="width:100%;height:100%;object-fit:cover;"
          >
          <div style="position:absolute;inset:0;background:linear-gradient(to right,rgba(58,45,45,0.6),transparent);display:flex;align-items:center;padding:2rem 3rem;">
            <div>
              <h1 style="color:white;margin-bottom:0.5rem;">{{ collection.title }}</h1>
              {%- if collection.description != blank -%}
                <p style="color:rgba(255,255,255,0.85);max-width:480px;">{{ collection.description | strip_html }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <p class="section-subtitle">Browse Our Selection</p>
        <h1>{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <p class="section-description mt-2">{{ collection.description | strip_html }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>

    <!-- Toolbar: Count + Sort -->
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;padding-bottom:1.25rem;border-bottom:1px solid var(--color-border);">
      <p style="font-size:0.85rem;color:var(--color-text-light);">
        Showing {{ collection.products.size }} product{% if collection.products.size != 1 %}s{% endif %}
      </p>
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <label for="sort-by" style="font-size:0.85rem;font-weight:600;">Sort by:</label>
        <select
          id="sort-by"
          name="sort_by"
          style="padding:0.5rem 1rem;border:2px solid var(--color-border);border-radius:8px;font-size:0.85rem;background:white;color:var(--color-text);cursor:pointer;outline:none;"
          onchange="window.location = '{{ collection.url }}?sort_by=' + this.value;"
        >
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <option value="manual"{% if sort_by == 'manual' %} selected{% endif %}>Featured</option>
          <option value="best-selling"{% if sort_by == 'best-selling' %} selected{% endif %}>Best Selling</option>
          <option value="title-ascending"{% if sort_by == 'title-ascending' %} selected{% endif %}>A–Z</option>
          <option value="title-descending"{% if sort_by == 'title-descending' %} selected{% endif %}>Z–A</option>
          <option value="price-ascending"{% if sort_by == 'price-ascending' %} selected{% endif %}>Price: Low to High</option>
          <option value="price-descending"{% if sort_by == 'price-descending' %} selected{% endif %}>Price: High to Low</option>
          <option value="created-descending"{% if sort_by == 'created-descending' %} selected{% endif %}>Newest</option>
        </select>
      </div>
    </div>

    <!-- Products Grid -->
    {%- if collection.products.size > 0 -%}
      <div class="products-grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="text-center" style="padding:4rem 0;">
        <div style="font-size:4rem;margin-bottom:1rem;" aria-hidden="true">🎂</div>
        <h2>No cakes found</h2>
        <p style="color:var(--color-text-light);margin:1rem 0 2rem;">This collection is empty right now. Check back soon!</p>
        <a href="{{ routes.collections_url }}" class="btn btn--primary">Browse All Cakes</a>
      </div>
    {%- endif -%}

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <span class="current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" aria-label="Next page">›</a>
        {%- endif -%}
      </nav>
    {%- endif -%}

  </div>
</div>

{%- endpaginate -%}
