<div style="padding:3rem 0 5rem;">
  <div class="container" style="max-width:800px;">

    <!-- Page Header -->
    {%- if page.title -%}
      <h1 style="font-family:var(--font-heading);margin-bottom:2rem;">{{ page.title }}</h1>
    {%- endif -%}

    <!-- Page Content -->
    <div class="rte" style="color:var(--color-text-light);line-height:1.8;font-size:1rem;">
      {{ page.content }}
    </div>

  </div>
</div>
