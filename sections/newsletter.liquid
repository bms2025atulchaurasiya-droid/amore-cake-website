<section class="newsletter-section" id="newsletter">
  <div class="container">
    <div class="newsletter-inner">
      <div class="newsletter-text">
        {%- if section.settings.subtitle != blank -%}
          <p class="section-subtitle" style="color:rgba(255,255,255,0.7);">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        <h2 class="newsletter-title">{{ section.settings.heading | default: 'Get Sweet Deals in Your Inbox' }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="newsletter-desc">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
      <form class="newsletter-form" method="post" action="/contact#newsletter" accept-charset="UTF-8">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="newsletter-email" class="visually-hidden">Email address</label>
        <input
          id="newsletter-email"
          class="newsletter-input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="btn btn--secondary">
          {{ section.settings.button_label | default: 'Subscribe' }}
        </button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Stay Updated"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Sweet Deals in Your Inbox"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Subscribe to our newsletter for exclusive offers, new cake designs and seasonal specials."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
