<section class="section-padding" id="why-us" style="background:var(--color-white);">
  <div class="container">
    <div class="text-center" data-reveal>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.heading | default: 'Why Choose Amore Cake?' }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-description mt-2">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="features-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="feature-item" {{ block.shopify_attributes }} data-reveal>
            <div class="feature-icon" aria-hidden="true">{{ block.settings.icon }}</div>
            <h3 class="feature-title">{{ block.settings.title }}</h3>
            <p class="feature-desc">{{ block.settings.description }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Us",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "The Amore Difference"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Why Choose Amore Cake?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section description"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "default": "🎂"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature title",
          "default": "Handcrafted"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature description",
          "default": "Every cake is made by hand with care and attention to detail."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "🎂",
            "title": "100% Handcrafted",
            "description": "Every cake is made by hand with care and attention to detail."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🌿",
            "title": "Fresh Ingredients",
            "description": "We use only the freshest, highest-quality ingredients with no artificial preservatives."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🎨",
            "title": "Custom Designs",
            "description": "Tell us your vision and we'll bring it to life in a stunning edible masterpiece."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🚚",
            "title": "Same-Day Delivery",
            "description": "Fresh cakes delivered to your doorstep on the same day."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "💯",
            "title": "Satisfaction Guaranteed",
            "description": "We stand behind every cake we make. Your happiness is our priority."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🏆",
            "title": "Award-Winning",
            "description": "Recognised for excellence in baking and design by local food guides."
          }
        }
      ]
    }
  ]
}
{% endschema %}
